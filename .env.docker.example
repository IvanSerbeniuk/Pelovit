# ── Скопіюйте цей файл у .env поруч із docker-compose.yml і заповніть ──
# docker compose підставляє ці змінні у контейнери (Laravel/Nuxt/DB).

# APP_KEY згенеруйте: docker compose run --rm laravel php artisan key:generate --show
APP_KEY=

# Публічні адреси (той самий домен з HTTPS)
APP_URL=https://develop-site.online
FRONTEND_URL=https://develop-site.online

# ── Database (MariaDB) ──
DB_DATABASE=pelovit
DB_USERNAME=pelovit
DB_PASSWORD=ЗМІНІТЬ_надійний_пароль
DB_ROOT_PASSWORD=ЗМІНІТЬ_надійний_root_пароль

# ── Пошта (Resend) ──
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@develop-site.online
ADMIN_EMAIL=serbeniuk.ivan@gmail.com

# ── Нова Пошта (порожньо = автозаповнення міст вимкнено) ──
NOVA_POSHTA_API_KEY=

# ── LiqPay (поки sandbox; після активації — бойові ключі) ──
LIQPAY_PUBLIC_KEY=sandbox_i97618994403
LIQPAY_PRIVATE_KEY=sandbox_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LIQPAY_SANDBOX=true

# ── Nuxt (той самий домен) ──
NUXT_PUBLIC_API_BASE=https://develop-site.online/api
NUXT_PUBLIC_ASSET_BASE=https://develop-site.online
NUXT_PUBLIC_SITE_URL=https://develop-site.online
